BT 1 0 0 1 8 182.4 Tm /F3 7.6 Tf 10 TL (# test_comiccraft.py) Tj T* (import unittest) Tj T* (from comiccraft_demo import create_comic) Tj T*  T* (class ComicCraftTests\(unittest.TestCase\):) Tj T* (    def test_valid_prompt_returns_four_panels\(self\):) Tj T* (        result = create_comic\("A robot learns to paint"\)) Tj T* (        self.assertEqual\(len\(result\), 4\)) Tj T*  T* (    def test_empty_prompt_shows_message\(self\):) Tj T* (        result = create_comic\(""\)) Tj T* (        self.assertEqual\(result, ["Please enter a story idea."]\)) Tj T*  T* (    def test_whitespace_prompt_is_rejected\(self\):) Tj T* (        result = create_comic\("   "\)) Tj T* (        self.assertEqual\(result, ["Please enter a story idea."]\)) Tj T*  T* (if __name__ == "__main__":) Tj T* (    unittest.main\(\)) Tj T* ET
